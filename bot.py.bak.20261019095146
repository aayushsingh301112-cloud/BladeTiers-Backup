)
@app_commands.describe(user="The member to promote to tester roles.")
async def at_command(
    interaction: discord.Interaction,
    user: discord.Member
):
    if interaction.guild is None:
        await interaction.response.send_message(
            "This command can only be used inside the server.",
            ephemeral=True
        )
        return

    if not interaction.user.guild_permissions.administrator:
        await interaction.response.send_message(
            "Administrator permission is required to use this command.",
            ephemeral=True
        )
        return

    role_names = ("TESTER TEAM", "Voluntary Testers")
    roles = []

    for role_name in role_names:
        role = discord.utils.get(
            interaction.guild.roles,
            name=role_name
        )
        if role is None:
            await interaction.response.send_message(
                f"Could not find the role **{role_name}**. "
                "No roles were assigned.",
                ephemeral=True
            )
            return
        roles.append(role)

    missing_roles = [role for role in roles if role not in user.roles]

    if not missing_roles:
        await interaction.response.send_message(
            f"{user.mention} already has both tester roles.",
            ephemeral=True
        )
        return

    try:
        await user.add_roles(
            *missing_roles,
            reason=f"Tester roles assigned by {interaction.user}"
        )
