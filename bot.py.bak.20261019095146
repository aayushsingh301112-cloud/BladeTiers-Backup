        username = registration[1]
        region = registration[2]

        account_type = registration[3] if len(registration) >= 4 else "cracked"

        if account_type == "cracked":
            skin_path = SKINS_DIR / f"{clean_username(username)}.png"

            if not skin_path.is_file():
                await interaction.followup.send(
                    "🖼️ **Skin Upload Required**\n\n"
                    f"Your cracked account **`{username}`** does not have a "
                    "Minecraft skin uploaded yet.\n\n"
                    "Please use `/skinupload` and attach your skin file "
                    "directly from your computer.\n\n"
                    "After uploading it successfully, come back and click "
                    "**Request Test** again.",
                    ephemeral=True
                )
                return

        role_name, _ = QUEUE_CONFIG[gamemode]

        role = discord.utils.get(
            interaction.guild.roles,
            name=role_name
        )

        if role is None:
            await interaction.followup.send(
                f"❌ Queue role `{role_name}` was not found.",
                ephemeral=True
            )
            return

        if any(
            str(entry.get("user_id")) == str(interaction.user.id)
            for entry in load_queue().get(gamemode, [])
        ):
            await interaction.followup.send(
                f"⚠️ You're already in the "
                f"**{gamemode.title()} queue!**",
                ephemeral=True
            )
            return

        queue = load_queue()

        waitlist_key = f"{gamemode}_waitlist"
        queue.setdefault(waitlist_key, [])

        # Enforce the cooldown for this gamemode before joining its waitlist.
        cooldown_remaining = get_test_cooldown_remaining(
            interaction.user.id,
            gamemode
        )

        if cooldown_remaining > 0:
            await interaction.followup.send(
                "⏳ **You are on a testing cooldown for this gamemode.**\\n\\n"
                f"You recently completed a **{gamemode.title()}** tier test.\\n"
                "You must wait 4 days before requesting another test in this gamemode.\\n\\n"
                f"**Time remaining:** `{format_test_cooldown(cooldown_remaining)}`\\n\\n"
                "You can still request tests in other gamemodes that aren't on cooldown.",
                ephemeral=True
            )
            return

        # Request Test = waitlist only.
        # Do NOT add the player to the active queue.
        if any(
            str(entry.get("user_id")) == str(interaction.user.id)
            for entry in queue[waitlist_key]
        ):
            await interaction.followup.send(
                f"⚠️ You're already on the "
                f"**{gamemode.title()} waitlist!**",
                ephemeral=True
            )
            return

        queue[waitlist_key].append({
            "user_id": str(interaction.user.id),
            "username": username,
            "region": region
        })

        save_queue(queue)

        try:
            if role not in interaction.user.roles:
                await interaction.user.add_roles(
                    role,
                    reason=f"Requested {gamemode.title()} tier test"
                )
        except discord.Forbidden:
            await interaction.followup.send(
                f"❌ I couldn't give you the `{role_name}` role.\n\n"
                "Please contact an administrator.",
                ephemeral=True
            )
            return

        await interaction.followup.send(
            f"✅ **Test Request Submitted!**\n\n"
            f"🎮 **Gamemode:** `{gamemode.title()}`\n"
            f"👤 **IGN:** `{username}`\n"
            f"🌍 **Region:** `{region}`\n\n"
            f"You have been given the `{role_name}` role.",
            ephemeral=True
