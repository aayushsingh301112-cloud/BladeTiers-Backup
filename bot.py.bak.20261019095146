    await interaction.response.send_message(message, ephemeral=True)




@bot.tree.command(
    name="setupstarrole",
    description="Give the * role access to existing ticket channels.",
    guild=discord.Object(id=int(GUILD_ID))
)
async def setupstarrole(interaction: discord.Interaction):
    if not interaction.user.guild_permissions.administrator:
        await interaction.response.send_message(
            "Administrator permission is required.",
            ephemeral=True
        )
        return

    guild = interaction.guild
    if guild is None:
        await interaction.response.send_message(
            "Use this command inside the server.",
            ephemeral=True
        )
        return

    star_role = discord.utils.get(guild.roles, name="*")
    if star_role is None:
        await interaction.response.send_message(
            'I could not find a role named exactly "*".',
            ephemeral=True
        )
        return

    await interaction.response.defer(ephemeral=True)

    names = {TEST_TICKET_CATEGORY_NAME, SUPPORT_TICKET_CATEGORY}
    categories = [c for c in guild.categories if c.name in names]
    updated = 0
    missing = sorted(names - {c.name for c in categories})
    errors = []

    permissions = discord.PermissionOverwrite(
        view_channel=True,
        send_messages=True,
        read_message_history=True,
        attach_files=True,
        embed_links=True
    )

    for category in categories:
        try:
            await category.set_permissions(
                star_role,
                overwrite=permissions,
                reason="Configure * role ticket access"
            )
        except discord.HTTPException as e:
            errors.append(f"{category.name}: category update failed ({e})")

        for channel in category.text_channels:
            try:
                await channel.set_permissions(
                    star_role,
                    overwrite=permissions,
                    reason="Configure * role ticket access"
                )
                updated += 1
            except discord.HTTPException as e:
                errors.append(f"#{channel.name}: {e}")

    result = (
        f'Role: {star_role.mention}\\n'
        f"Categories found: {len(categories)}/{len(names)}\\n"
        f"Existing ticket channels updated: {updated}"
    )
    if missing:
        result += "\\nMissing categories: " + ", ".join(missing)
    if errors:
        result += "\\nErrors (first 5):\\n" + "\\n".join(errors[:5])

    await interaction.followup.send(result, ephemeral=True)

