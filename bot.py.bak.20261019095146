async def compare(
    interaction: discord.Interaction,
    player1: str,
    player2: str
):
    try:
        with open(TIERS_FILE, "r", encoding="utf-8") as f:
            tier_data = json.load(f)
    except Exception:
        tier_data = {}

    def find_player(query):
        query = str(query).strip().lower()

        for key, value in tier_data.items():
            if str(key).strip().lower() == query:
                if isinstance(value, dict):
                    return str(key), value

        return None, None

    name1, tiers1 = find_player(player1)
    name2, tiers2 = find_player(player2)

    if name1 is None:
        await interaction.response.send_message(
            f"❌ **Player not found:** `{player1}`\n\n"
            "Make sure the IGN exists in BladeTiers tier data.",
            ephemeral=True
        )
        return

    if name2 is None:
        await interaction.response.send_message(
            f"❌ **Player not found:** `{player2}`\n\n"
            "Make sure the IGN exists in BladeTiers tier data.",
            ephemeral=True
        )
        return

    gamemodes = [
        ("vanilla", "Vanilla"),
        ("uhc", "UHC"),
        ("pot", "Pot"),
        ("nethop", "NethOP"),
        ("smp", "SMP"),
        ("sword", "Sword"),
        ("axe", "Axe"),
        ("mace", "Mace"),
        ("spear", "Spear"),
    ]

    def format_tiers(tiers):
        lines = []

        for mode_key, display_name in gamemodes:
            tier = tiers.get(mode_key)

            if tier:
                lines.append(
                    f"**{display_name}:** `{str(tier).upper()}`"
                )

        # Also show any future/unknown gamemode stored in tiers.json.
        known_modes = {mode[0] for mode in gamemodes}

        for mode, tier in tiers.items():
            mode_lower = str(mode).lower()

            if mode_lower not in known_modes and tier:
                lines.append(
                    f"**{str(mode).title()}:** `{str(tier).upper()}`"
                )

        return "\n".join(lines) if lines else "*No tiers yet.*"

