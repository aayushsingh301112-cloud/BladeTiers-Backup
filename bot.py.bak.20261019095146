async def applystaff(interaction,user:discord.Member):
    if not interaction.user.guild_permissions.administrator and not has_role(interaction.user, "Senior Mod"):
        return await interaction.response.send_message("❌ **Senior Mod or Administrator only.**",ephemeral=True)
    if user.bot:
        return await interaction.response.send_message("❌ You cannot create a staff application for a bot.",ephemeral=True)
    # Remove stale staff applications whose 30-minute view has expired.
    for message_id, active_app in list(ACTIVE_STAFF_APPLICATIONS.items()):
        if active_app.get("created_at") is not None and __import__("time").time() - active_app["created_at"] > 1800:
            ACTIVE_STAFF_APPLICATIONS.pop(message_id, None)
    if any(x["user_id"] == user.id for x in ACTIVE_STAFF_APPLICATIONS.values()):
        return await interaction.response.send_message(f"❌ {user.mention} already has an active staff application. If the previous one is stuck, cancel it or ask an administrator to clear it.", ephemeral=True)

    app={"user_id":user.id,"index":0,"answers":[],"created_at":__import__("time").time()}
    view = StaffApplicationView(0)
    await interaction.response.send_message(
        content=user.mention,
        embed=staff_embed(app),
        view=view,
        allowed_mentions=discord.AllowedMentions(users=True)
    )
    msg = await interaction.original_response()
    app["message_id"] = msg.id
    ACTIVE_STAFF_APPLICATIONS[msg.id] = app
    view.mid = msg.id

    print(f"📋 Staff application started | Applicant: {user} ({user.id}) | Started by: {interaction.user}")




