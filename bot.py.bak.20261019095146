        e.set_footer(text="BladeTiers Staff Applications")
        review_view = StaffApplicationReviewView(interaction.user.id)
        await ch.send(embed=e, view=review_view)
        ACTIVE_STAFF_APPLICATIONS.pop(self.mid,None)

        await interaction.response.edit_message(
            content="✅ **Staff application submitted!**\n\nYour answers have been sent to the BladeTiers staff team.",
            embed=None,
            view=None
        )

