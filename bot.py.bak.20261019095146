@bot.tree.command(
    name="lookup",
    description="Look up a player's Minecraft IGN and Discord account.",
    guild=discord.Object(id=int(GUILD_ID))
)
@app_commands.describe(
    ign="The Minecraft IGN to look up."
)
async def lookup(
    interaction: discord.Interaction,
    ign: str
):
    target_ign = ign.strip().lower()

    if not target_ign:
        await interaction.response.send_message(
            "❌ Please provide a Minecraft IGN.",
            ephemeral=True
        )
        return

    registration_file = BASE_DIR / "registrations.txt"

    if not registration_file.exists():
        await interaction.response.send_message(
            "❌ No registration data is available.",
            ephemeral=True
        )
        return

    found = None

    try:
        with open(
            registration_file,
            "r",
            encoding="utf-8"
        ) as f:
            for line in f:
                parts = line.rstrip("\n").split("|")

                if len(parts) < 2:
                    continue

                discord_id = parts[0].strip()
                username = parts[1].strip()

                if username.lower() == target_ign:
                    region = parts[2].strip() if len(parts) >= 3 else "Unknown"
                    account_type = (
                        parts[3].strip().title()
                        if len(parts) >= 4
                        else "Cracked"
                    )

                    found = (
                        discord_id,
                        username,
                        region,
                        account_type
                    )
                    break

    except OSError:
        await interaction.response.send_message(
            "❌ Could not read registration data.",
            ephemeral=True
        )
        return

    if found is None:
        await interaction.response.send_message(
            f"❌ No registered player found with the IGN `{ign}`.",
            ephemeral=True
        )
        return

    discord_id, username, region, account_type = found

    try:
        discord_user = await bot.fetch_user(int(discord_id))
        discord_display = discord_user.mention
    except (
        discord.NotFound,
        discord.HTTPException,
        ValueError,
        TypeError
    ):
        discord_display = f"<@{discord_id}>"

    embed = discord.Embed(
        title="🔎 Player Lookup",
        description=f"Information for **{username}**",
        color=discord.Color.blurple()
    )

    embed.add_field(
        name="🎮 Minecraft IGN",
        value=f"`{username}`",
        inline=True
    )

    embed.add_field(
        name="💬 Discord",
        value=discord_display,
        inline=True
    )

    embed.add_field(
        name="🌎 Region",
        value=f"`{region}`",
        inline=True
    )

    embed.add_field(
        name="👤 Account Type",
        value=f"`{account_type}`",
        inline=True
    )

    embed.set_footer(
        text="BladeTiers Player Lookup"
    )

    await interaction.response.send_message(
        embed=embed,
        ephemeral=False
    )


@bot.tree.command(
    name="warn",
    description="Issue a warning to a server member.",
    guild=discord.Object(id=int(GUILD_ID))
)
@app_commands.describe(
    user="The member receiving the warning.",
    reason="The rule they violated."
)
async def warn(
    interaction: discord.Interaction,
    user: discord.Member,
    reason: str
):
    guild = interaction.guild
    moderator = interaction.user

    if guild is None:
        await interaction.response.send_message(
            "Use this command inside the server.",
            ephemeral=True,
        )
        return

    staff_role_names = {
        "discord helper", "mod", "mods", "mod team",
        "moderator", "moderators", "senior mod", "admin",
        "administrator", "owner",
    }

    is_staff = (
        moderator.guild_permissions.administrator
        or moderator.guild_permissions.manage_messages
        or any(
            role.name.lower() in staff_role_names
            for role in moderator.roles
        )
    )

    if not is_staff:
        await interaction.response.send_message(
            "You need moderator permissions to issue warnings.",
            ephemeral=True,
        )
        return

    if user.bot or user.id == moderator.id:
        await interaction.response.send_message(
            "You cannot warn yourself or a bot.",
            ephemeral=True,
        )
        return

    # Protect the server owner from staff warnings.
    if user.id == guild.owner_id:
        await interaction.response.send_message(
            "The server owner cannot be warned using this command.",
            ephemeral=True,
        )
        return

    # Only the server owner may moderate members above their own role.
    # Everyone else must have a strictly higher top role than the target.
    if moderator.id != guild.owner_id and user.top_role >= moderator.top_role:
        await interaction.response.send_message(
            "❌ You cannot warn someone whose highest role is equal to "
            "or higher than yours.",
            ephemeral=True,
        )
        return

    reason = reason.strip()
    if not reason:
        await interaction.response.send_message(
            "Please provide a reason.",
            ephemeral=True,
        )
        return

    warnings_file = BASE_DIR / "warnings.json"

    try:
        data = (
            json.loads(warnings_file.read_text(encoding="utf-8"))
            if warnings_file.exists()
            else {}
        )
        if not isinstance(data, dict):
            raise ValueError("Warning data must be a JSON object.")

        entry = data.get(str(user.id), {})
        if isinstance(entry, int):
            previous_count = entry
            history = []
        else:
            previous_count = int(entry.get("count", 0))
            history = entry.get("history", [])

        # Keep the displayed strike count at 3/3 after the third strike.
        count = min(previous_count + 1, 3)
        history.append({
            "reason": reason,
            "moderator_id": moderator.id,
            "timestamp": datetime.now().astimezone().isoformat(),
        })

        data[str(user.id)] = {
            "count": count,
            "history": history,
        }

        temp_file = warnings_file.with_suffix(".json.tmp")
        temp_file.write_text(
            json.dumps(data, indent=2, ensure_ascii=False),
            encoding="utf-8",
        )
        temp_file.replace(warnings_file)

    except (OSError, ValueError, TypeError, AttributeError) as error:
        print(f"Warning storage error: {error}")
        await interaction.response.send_message(
            "The warning could not be saved, so no warning was issued. "
            "Please contact the bot administrator.",
            ephemeral=True,
        )
        return

    timeout_applied = False
    timeout_error = None

    if count >= 3:
        try:
            await user.timeout(
                timedelta(days=1),
                reason=f"Reached 3 warnings. Latest reason: {reason}",
            )
            timeout_applied = True
        except (discord.Forbidden, discord.HTTPException) as error:
            timeout_error = error
            print(f"Warning timeout failed for {user.id}: {error}")

    if count < 3:
        dm_message = (
            f"⚠️ **Warning ({count}/3):** You violated a chat rule "
            f"({reason}). Reaching 3 warnings will result in a timeout."
        )
    elif timeout_applied:
        dm_message = (
            f"⚠️ **Warning (3/3):** You violated a chat rule "
            f"({reason}). You have reached 3 warnings and received "
            f"a **1-day timeout**."
        )
    else:
        dm_message = (
            f"⚠️ **Warning (3/3):** You violated a chat rule "
            f"({reason}). You have reached 3 warnings, but the bot "
            f"could not apply the 1-day timeout automatically. "
            f"Please contact the server staff."
        )

    dm_sent = True
    try:
        await user.send(dm_message)
    except (discord.Forbidden, discord.HTTPException):
        dm_sent = False

    result = [
        f"⚠️ Warning issued to {user.mention}: **{count}/3**.",
        f"Reason: {reason}",
        f"DM: {'sent' if dm_sent else 'failed (their DMs may be closed)'}.",
    ]

    if count >= 3:
        result.append(
            "Timeout: **1 day applied**."
            if timeout_applied
            else "Timeout: **FAILED** — check my permissions and role hierarchy."
        )

    await interaction.response.send_message(
        "\\n".join(result),
        ephemeral=True,
    )


@bot.tree.command(name="rename", description="Ticket management commands.", guild=discord.Object(id=int(GUILD_ID)))
@app_commands.describe(ticket="The new ticket channel name.")
async def rename(interaction: discord.Interaction, ticket: str):
    name = ticket
    guild = interaction.guild
    channel = interaction.channel
    member = interaction.user

    if guild is None or not isinstance(channel, discord.TextChannel):
        await interaction.response.send_message(
            "Use this command inside a server ticket channel.",
            ephemeral=True,
        )
        return

    is_admin = member.guild_permissions.administrator
    helper_role = discord.utils.get(guild.roles, name="Discord Helper")
    tester_role = discord.utils.get(guild.roles, name="TESTER TEAM")

    is_staff = (
        is_admin
        or (helper_role is not None and helper_role in member.roles)
        or (tester_role is not None and tester_role in member.roles)
    )

    if not is_staff:
        await interaction.response.send_message(
            "You need Discord Helper, TESTER TEAM, or Administrator permission.",
            ephemeral=True,
        )
        return

    category_name = channel.category.name.lower() if channel.category else ""
    channel_name = channel.name.lower()

    is_ticket = (
        "-test-" in channel_name
        or "ticket" in channel_name
        or "support" in channel_name
        or "ticket" in category_name
        or "support" in category_name
        or "test" in category_name
    )

    if not is_ticket:
        await interaction.response.send_message(
            "This command can only be used inside a ticket channel.",
            ephemeral=True,
        )
        return

    import re
    new_name = re.sub(r"\s+", "-", name.strip().lower())
    new_name = re.sub(r"[^a-z0-9_-]", "", new_name).strip("-_")

    if not new_name:
        await interaction.response.send_message(
            "Enter a valid channel name.",
            ephemeral=True,
        )
        return

    if len(new_name) > 100:
        await interaction.response.send_message(
            "Channel names must be 100 characters or fewer.",
            ephemeral=True,
        )
        return

    old_name = channel.name

    try:
        await channel.edit(
            name=new_name,
            reason=f"Ticket renamed by {member}",
        )
        await interaction.response.send_message(
            f"✅ Renamed **#{old_name}** to **#{channel.name}**."
        )
    except discord.Forbidden:
        await interaction.response.send_message(
            "I don't have permission to rename this channel.",
            ephemeral=True,
        )
    except discord.HTTPException:
        await interaction.response.send_message(
            "Discord couldn't rename this channel. Please try again.",
            ephemeral=True,
        )


