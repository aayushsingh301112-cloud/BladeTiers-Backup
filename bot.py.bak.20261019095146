        not is_tester
        and not interaction.user.guild_permissions.manage_messages
    ):
        await interaction.followup.send(
            "❌ **TESTER TEAM only.**",
            ephemeral=True
        )
        return

    mode = gamemode.value
    server = server.strip()

    if not server:
        await interaction.followup.send(
            "❌ Please provide a server IP.",
            ephemeral=True
