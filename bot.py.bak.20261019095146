@bot.command(name="delq")
async def delq(ctx):
    if not ctx.guild or not (
        ctx.author.guild_permissions.administrator
        or has_role(ctx.author, "TESTER TEAM")
    ):
        return await ctx.send(
            "❌ You don't have permission to use this command.",
            delete_after=5
        )

    mode = next(
        (
            m for m, (_, ch) in QUEUE_CONFIG.items()
            if ch == ctx.channel.name
        ),
        None
    )

    if not mode:
        return await ctx.send(
            "❌ This is not a queue channel.",
            delete_after=5
        )

    queue = load_queue()

    entries = queue.get(mode, [])

    if not isinstance(entries, list):
        entries = []

    role = discord.utils.get(
        ctx.guild.roles,
        name=QUEUE_CONFIG[mode][0]
    )

    for entry in entries:
        try:
            member = (
                ctx.guild.get_member(int(entry["user_id"]))
                or await ctx.guild.fetch_member(
                    int(entry["user_id"])
                )
            )

            if role and role in member.roles:
                await member.remove_roles(
                    role,
                    reason=f"{mode.title()} queue cleared"
                )

        except Exception:
            pass

    queue[mode] = []
    queue.pop(mode + "_active_tester", None)
    queue.pop(f"{mode}_server", None)

    save_queue(queue)

    # Clear the queue channel without deleting the owner's messages.
    try:
        owner_id = 1359186600797671507

        messages_to_delete = []

        async for message in ctx.channel.history(limit=None):
            if message.author.id != owner_id:
                messages_to_delete.append(message)

        # Delete in batches to avoid Discord's bulk-delete age limit.
        for i in range(0, len(messages_to_delete), 100):
            batch = messages_to_delete[i:i + 100]

            if batch:
                await ctx.channel.delete_messages(batch)

    except Exception as error:
        print(
            f"❌ Queue purge failed in #{ctx.channel.name}: {error}"
        )

    # Post queue-closed status message for every gamemode
    emoji_names={"axe":["axe~1","axe"],"sword":["sword~2","sword"],"vanilla":["vanilla"],"smp":["smp"],"pot":["pot"],"mace":["mace"],"nethop":["nethop"],"uhc":["uhc"],"spear":["spear"]}
    mode_emoji=next((discord.utils.get(ctx.guild.emojis,name=n) for n in emoji_names.get(mode,[mode]) if discord.utils.get(ctx.guild.emojis,name=n)),None)
    emoji_text=str(mode_emoji) if mode_emoji else ""
    closed_embed = discord.Embed(
        title=f"{emoji_text} {mode.upper()} QUEUE CLOSED",
        description=f"The {mode.title()} tier test queue is currently closed.",
        color=discord.Color.red()
    )
    closed_embed.add_field(
        name="Closed on",
        value=discord.utils.utcnow().strftime("%d %B %Y"),
        inline=False
    )

    closed_message = await ctx.channel.send(embed=closed_embed)

    queue[f"{mode}_closed_message_id"] = closed_message.id
    save_queue(queue)

    print(
        f"Queue deleted | Gamemode: {mode} | "
        f"Cleared: {len(entries)} players"
    )


async def restore_active_tier_test_views():
    """Restore tier-test buttons after a bot restart."""
    queue = load_queue()
    restored = 0
    registration_file = BASE_DIR / "registrations.txt"

    for gamemode in QUEUE_CONFIG:
        current_key = f"{gamemode}_currently_testing"
        username = queue.get(current_key)
        if not username:
            continue

        tester_id = get_active_tester(gamemode)
        if not tester_id:
            print(f"⚠️ {gamemode}: active tester not found for {username}")
            continue

        registration = None
        if registration_file.exists():
            with open(registration_file, "r", encoding="utf-8") as f:
                for line in f:
                    parts = line.rstrip("\n").split("|")
                    if len(parts) >= 4 and clean_username(parts[1]) == clean_username(str(username)):
                        registration = parts
                        break

        if not registration:
            print(f"⚠️ {gamemode}: registration not found for {username}")
            continue

        player_entry = {
            "user_id": registration[0],
            "username": str(username),
            "region": registration[2]
        }

        bot.add_view(TierResultView(
            gamemode=gamemode,
            tester_id=int(tester_id),
            player_entry=player_entry
        ))
        restored += 1
        print(f"♻️ Restored {gamemode} test buttons for {username}")

    print(f"♻️ Restart recovery: restored {restored} active test(s).")



