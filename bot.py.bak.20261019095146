        content=announcement_content,
        embed=embed,
        view=QueuePanelView(mode),
        allowed_mentions=discord.AllowedMentions(
            roles=True
        )
    )

    # Store the exact panel message so future refreshes can
    # fetch it directly instead of scanning channel history.
    queue = load_queue()
    queue[f"{mode}_panel_message_id"] = panel_message.id
    save_queue(queue)

    await interaction.followup.send(
        f"✅ **{mode.title()} queue opened!**\n"
