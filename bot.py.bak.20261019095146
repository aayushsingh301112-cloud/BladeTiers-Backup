# ==================== TEMPORARY RESTRICTIONS ====================

RESTRICTIONS_FILE = BASE_DIR / "restrictions.json"
RESTRICTED_ROLE_NAME = "Restricted"

def load_restrictions():
    try:
        data = json.loads(RESTRICTIONS_FILE.read_text(encoding="utf-8"))
        return data if isinstance(data, dict) else {}
    except FileNotFoundError:
        return {}
    except (json.JSONDecodeError, OSError):
        print("[Restrictions] Could not read restrictions.json; keeping data untouched.")
        return {}

def save_restrictions(data):
    temp_file = RESTRICTIONS_FILE.with_suffix(".json.tmp")
    temp_file.write_text(
        json.dumps(data, indent=2),
        encoding="utf-8",
    )
    temp_file.replace(RESTRICTIONS_FILE)

RESTRICTION_STAFF_ROLES = {
    "discord helper", "mod", "mods", "mod team",
    "moderator", "moderators", "senior mod", "admin",
    "administrator", "owner",
}

async def restriction_staff_check(interaction, target):
    guild = interaction.guild
    moderator = interaction.user

    if guild is None:
        await interaction.response.send_message(
            "Use this command inside the server.", ephemeral=True
        )
        return False

    is_staff = (
        moderator.guild_permissions.administrator
        or moderator.guild_permissions.manage_messages
        or any(
            role.name.lower() in RESTRICTION_STAFF_ROLES
            for role in moderator.roles
        )
    )

    if not is_staff:
        await interaction.response.send_message(
            "You need moderator permissions to use this command.",
            ephemeral=True,
        )
        return False

    if target.bot or target.id == moderator.id:
        await interaction.response.send_message(
            "You cannot restrict yourself or a bot.", ephemeral=True
        )
        return False

    if target.id == guild.owner_id:
        await interaction.response.send_message(
            "The server owner cannot be restricted using this command.",
            ephemeral=True,
        )
        return False

    if moderator.id != guild.owner_id and target.top_role >= moderator.top_role:
        await interaction.response.send_message(
            "You cannot moderate someone whose highest role is equal to "
            "or higher than yours.",
            ephemeral=True,
        )
        return False

    return True

async def refresh_restriction_queue_panel(guild, mode):
    try:
        _, channel_name = QUEUE_CONFIG[mode]
        channel = discord.utils.get(guild.text_channels, name=channel_name)
        if channel is None:
            return

        queue_data = load_queue()
        message_id = queue_data.get(f"{mode}_panel_message_id")
        if not message_id:
            return

        message = await channel.fetch_message(int(message_id))
        await message.edit(
            embed=await build_queue_embed(guild, mode),
            view=QueuePanelView(mode),
        )
    except (
        discord.NotFound, discord.Forbidden, discord.HTTPException,
        ValueError, TypeError
    ):
        pass

async def clear_member_from_all_queues(guild, member):
    queue = load_queue()
    changed_modes = set()
    uid = str(member.id)

    # Remove the member from every active queue and every waitlist.
    for mode in QUEUE_CONFIG:
        for key in (mode, f"{mode}_waitlist"):
            entries = queue.get(key)
            if not isinstance(entries, list):
                continue

            filtered = [
                entry for entry in entries
                if not (
                    isinstance(entry, dict)
                    and str(entry.get("user_id")) == uid
                )
            ]

            if len(filtered) != len(entries):
                queue[key] = filtered
                changed_modes.add(mode)

    if changed_modes:
        save_queue(queue)

    # Remove only roles used by the configured testing queues.
    queue_role_names = {
        role_name for role_name, _ in QUEUE_CONFIG.values()
    }
    roles_to_remove = [
        role for role in member.roles
        if role.name in queue_role_names
    ]
    if roles_to_remove:
        try:
            await member.remove_roles(
                *roles_to_remove,
                reason="Member temporarily restricted from tier testing",
            )
        except (discord.Forbidden, discord.HTTPException) as exc:
            print(f"[Restrictions] Could not remove queue roles for {uid}: {exc}")

    for mode in changed_modes:
        await refresh_restriction_queue_panel(guild, mode)

@tasks.loop(minutes=1)
async def restriction_expiry_task():
    guild_id = int(GUILD_ID)
    guild = bot.get_guild(guild_id)
    if guild is None:
        return

    data = load_restrictions()
    now = time.time()
    changed = False
    role = discord.utils.get(guild.roles, name=RESTRICTED_ROLE_NAME)

    for uid, record in list(data.items()):
        if not isinstance(record, dict):
            continue

        try:
            expires_at = float(record["expires_at"])
            member_id = int(uid)
        except (KeyError, TypeError, ValueError):
            continue

        if expires_at > now:
            continue

        try:
            member = guild.get_member(member_id)
            if member is None:
                member = await guild.fetch_member(member_id)

            if role is not None and role in member.roles:
                await member.remove_roles(
                    role, reason="Temporary restriction expired"
                )

            del data[uid]
            changed = True

            try:
                await member.send(
                    "✅ Your temporary BladeTiers restriction has expired. "
                    "The Restricted role has been removed."
                )
            except (discord.Forbidden, discord.HTTPException):
                pass

        except discord.NotFound:
            # The member left the server; there is no role left to remove.
            del data[uid]
            changed = True
        except (discord.Forbidden, discord.HTTPException) as exc:
            # Keep the record so the task can retry on its next run.
            print(f"[Restrictions] Expiry cleanup failed for {uid}: {exc}")

    if changed:
        save_restrictions(data)

@restriction_expiry_task.before_loop
async def before_restriction_expiry_task():
    await bot.wait_until_ready()

@bot.tree.command(
    name="restrict",
    description="Temporarily restrict a member from tier testing.",
    guild=discord.Object(id=int(GUILD_ID)),
)
@app_commands.describe(
    user="The member to restrict.",
    days="How many days the restriction lasts (1–365).",
    reason="Why the restriction is being issued.",
)
async def restrict(
    interaction: discord.Interaction,
    user: discord.Member,
    days: app_commands.Range[int, 1, 365],
    reason: str,
):
    if not await restriction_staff_check(interaction, user):
        return

    reason = reason.strip()
    if not reason:
        await interaction.response.send_message(
            "Please provide a reason.", ephemeral=True
        )
        return

    role = discord.utils.get(
        interaction.guild.roles, name=RESTRICTED_ROLE_NAME
    )
    if role is None:
        await interaction.response.send_message(
            'The **Restricted** role does not exist. Create it first, '
            'then run this command again.',
            ephemeral=True,
        )
        return

    if role >= interaction.guild.me.top_role:
        await interaction.response.send_message(
            "I cannot manage the Restricted role because it is equal to "
            "or above my highest role. Move the role below my bot role.",
            ephemeral=True,
        )
        return

    now = time.time()
    expires_at = now + days * 86400
    data = load_restrictions()
    data[str(user.id)] = {
        "issued_at": now,
        "expires_at": expires_at,
        "duration_days": days,
        "reason": reason,
        "moderator_id": interaction.user.id,
    }

    try:
        if role not in user.roles:
            await user.add_roles(role, reason=f"Temporary restriction: {reason}")
        save_restrictions(data)
    except (discord.Forbidden, discord.HTTPException, OSError) as exc:
        await interaction.response.send_message(
            "I couldn't apply or save the restriction. Check my role "
            f"permissions and bot logs. Error: `{type(exc).__name__}`",
            ephemeral=True,
        )
        return

    await clear_member_from_all_queues(interaction.guild, user)

    expiry_text = datetime.fromtimestamp(expires_at).astimezone().strftime(
        "%d %b %Y, %I:%M %p %Z"
    )
    try:
        await user.send(
            f"🚫 You have been temporarily restricted from BladeTiers.\n\n"
            f"**Duration:** {days} day(s)\n"
            f"**Reason:** {reason}\n"
            f"**Expires:** {expiry_text}\n\n"
            "You cannot join tier-testing queues while the Restricted "
            "role is active."
        )
    except (discord.Forbidden, discord.HTTPException):
        pass

    await interaction.response.send_message(
        f"✅ Restricted {user.mention} for **{days} day(s)**.\n"
        f"**Reason:** {reason}\n"
        f"**Expires:** {expiry_text}\n"
        "They have been removed from all active queues and waitlists.",
        ephemeral=True,
    )

@bot.tree.command(
    name="unrestrict",
    description="Remove a member's restriction early.",
    guild=discord.Object(id=int(GUILD_ID)),
)
@app_commands.describe(user="The member to unrestrict.")
async def unrestrict(
    interaction: discord.Interaction,
    user: discord.Member,
):
    if not await restriction_staff_check(interaction, user):
        return

    role = discord.utils.get(
        interaction.guild.roles, name=RESTRICTED_ROLE_NAME
    )
    data = load_restrictions()
    had_record = data.pop(str(user.id), None) is not None

    try:
        if role is not None and role in user.roles:
            if interaction.guild.me is None or role >= interaction.guild.me.top_role:
                await interaction.response.send_message(
                    "I cannot remove the Restricted role. Check my role hierarchy.",
                    ephemeral=True,
                )
                return
            await user.remove_roles(role, reason="Restriction removed by staff")
        save_restrictions(data)
    except (discord.Forbidden, discord.HTTPException, OSError) as exc:
        await interaction.response.send_message(
            f"Could not remove the restriction: `{type(exc).__name__}`.",
            ephemeral=True,
        )
        return

    if not had_record and (role is None or role not in user.roles):
        await interaction.response.send_message(
            f"{user.mention} has no active restriction.", ephemeral=True
        )
        return

    try:
        await user.send(
            "✅ Your BladeTiers restriction has been removed by staff. "
            "You may join tier-testing queues again."
        )
    except (discord.Forbidden, discord.HTTPException):
        pass

    await interaction.response.send_message(
        f"✅ Removed the restriction from {user.mention}.",
        ephemeral=True,
    )

@bot.tree.command(
    name="restrictioninfo",
    description="View a member's temporary restriction details.",
    guild=discord.Object(id=int(GUILD_ID)),
)
@app_commands.describe(user="The member to check.")
async def restrictioninfo(
    interaction: discord.Interaction,
    user: discord.Member,
):
    if not await restriction_staff_check(interaction, user):
        return

    data = load_restrictions()
    record = data.get(str(user.id))
    role = discord.utils.get(
        interaction.guild.roles, name=RESTRICTED_ROLE_NAME
    )

    if not isinstance(record, dict):
        if role is not None and role in user.roles:
            message = (
                f"{user.mention} has the Restricted role, but no saved "
                "expiry/reason record was found. Use `/unrestrict` to remove it."
            )
        else:
            message = f"{user.mention} has no saved temporary restriction."
        await interaction.response.send_message(message, ephemeral=True)
        return

    try:
        expires_at = float(record["expires_at"])
        expiry_text = datetime.fromtimestamp(expires_at).astimezone().strftime(
            "%d %b %Y, %I:%M %p %Z"
        )
        remaining = max(0, int(expires_at - time.time()))
    except (KeyError, TypeError, ValueError, OSError):
        await interaction.response.send_message(
            "The saved restriction record is invalid; check restrictions.json.",
            ephemeral=True,
        )
        return

    status = "Expired; automatic cleanup is pending." if remaining == 0 else (
        f"{remaining // 86400} day(s), "
        f"{(remaining % 86400) // 3600} hour(s) remaining."
    )
    await interaction.response.send_message(
        f"**Restriction details for {user.mention}**\n"
        f"**Reason:** {record.get('reason', 'Not recorded')}\n"
        f"**Expires:** {expiry_text}\n"
        f"**Status:** {status}\n"
        f"**Issued by:** <@{record.get('moderator_id', 'unknown')}>",
        ephemeral=True,
    )

