async def create_tier_test_ticket(
    guild,
    gamemode,
    tester,
    player_entry
):
    """Create a private tier-test ticket."""
    username = player_entry.get("username", "Unknown")
    player_id = int(player_entry["user_id"])

    category = discord.utils.get(
        guild.categories,
        name=TEST_TICKET_CATEGORY_NAME
    )

    if category is None:
        raise RuntimeError(
            f'Category "{TEST_TICKET_CATEGORY_NAME}" was not found.'
        )

    player = guild.get_member(player_id)

    if player is None:
        player = await guild.fetch_member(player_id)

    overwrites = {
        guild.default_role: discord.PermissionOverwrite(
            view_channel=False
        ),
        tester: discord.PermissionOverwrite(
            view_channel=True,
            send_messages=True,
            read_message_history=True,
            attach_files=True,
            embed_links=True
        ),
        player: discord.PermissionOverwrite(
            view_channel=True,
            send_messages=True,
            read_message_history=True,
            attach_files=True,
            embed_links=True
        ),
        **{
            role: discord.PermissionOverwrite(
                view_channel=True,
                send_messages=True,
                read_message_history=True,
                attach_files=True,
                embed_links=True
            )
            for role in guild.roles
            if role.name == "Senior Tester"
        },
        guild.me: discord.PermissionOverwrite(
            view_channel=True,
            send_messages=True,
            manage_channels=True,
            manage_messages=True,
            read_message_history=True,
            embed_links=True
        )
    }

    star_role = discord.utils.get(guild.roles, name="*")
    if star_role:
        overwrites[star_role] = discord.PermissionOverwrite(
            view_channel=True,
            send_messages=True,
            read_message_history=True,
            attach_files=True,
            embed_links=True
        )

    safe_name = clean_username(username).lower()

    ticket = await guild.create_text_channel(
        name=f"{gamemode}-test-{safe_name}",
        category=category,
        overwrites=overwrites,
        reason=(
            f"{gamemode.title()} tier test taken by "
            f"{tester}"
        )
    )

    embed = discord.Embed(
        title=f"🧪 {gamemode.title()} Tier Test",
        description=(
            f"**Player:** {player.mention}\n"
            f"**IGN:** `{username}`\n"
            f"**Region:** `{player_entry.get('region', 'Unknown')}`\n"
            f"**Tester:** {tester.mention}\n\n"
            "🎯 **Only the assigned tester can select "
            "the final tier.**\n\n"
            "Good luck with the test! 🍀"
        ),
        color=discord.Color.from_rgb(57, 255, 20)
    )

    view = TierResultView(
        gamemode=gamemode,
        tester_id=tester.id,
        player_entry=player_entry
    )

    await ticket.send(
        content=f"{tester.mention} {player.mention}",
        embed=embed,
        view=view,
        allowed_mentions=discord.AllowedMentions(users=True)
    )

    return ticket


class QueuePanelView(discord.ui.View):

    def __init__(self, gamemode):
        super().__init__(timeout=None)
        self.gamemode = gamemode

        # Make Join/Leave IDs unique for every gamemode.
        # This prevents Discord from confusing buttons between queue panels.
        for child in self.children:
            if isinstance(child, discord.ui.Button):
                if child.label == "Join":
                    child.custom_id = f"tierbot_queue_join_{gamemode}"
                elif child.label == "Leave":
                    child.custom_id = f"tierbot_queue_leave_{gamemode}"

        take_button = discord.ui.Button(
            label="Take #1",
            style=discord.ButtonStyle.primary,
            emoji="🎯",
            custom_id=f"tierbot_queue_take_1_{gamemode}"
        )

        async def take_callback(interaction):
            await self.take_one_button(
                interaction,
                take_button
            )

        take_button.callback = take_callback
        self.add_item(take_button)

    @discord.ui.button(
        label="Join",
        style=discord.ButtonStyle.success,
        emoji="✅",
        custom_id="tierbot_queue_join"
    )
    async def join_button(
        self,
        interaction: discord.Interaction,
        button: discord.ui.Button
    ):
        if interaction.guild is None:
            await interaction.response.send_message(
                "❌ This can only be used inside a server.",
                ephemeral=True
            )
            return

        registration = get_registration(
            interaction.user.id
        )

        if registration is None:
            await interaction.response.send_message(
                "❌ **You are not registered yet.**\n\n"
                "Use the **Register / Update** button first.",
                ephemeral=True
            )
            return

        username = registration[1]
        region = registration[2]

        role_name, _ = QUEUE_CONFIG[self.gamemode]

        role = discord.utils.get(
            interaction.guild.roles,
            name=role_name
        )

        if role is None:
            await interaction.response.send_message(
                f"❌ Queue role `{role_name}` was not found.",
                ephemeral=True
            )
            return

        # -------------------------------------------------
        # Prevent duplicate entry in the SAME gamemode only.
        # Players may be in multiple gamemode queues.
        # -------------------------------------------------

        queue = load_queue()
        queue.setdefault(self.gamemode, [])

        waitlist_key = f"{self.gamemode}_waitlist"
        queue.setdefault(waitlist_key, [])

        user_id = str(interaction.user.id)

        # The tester who opened this queue cannot join it as a player.
        active_tester_id = get_active_tester(self.gamemode)
        if str(active_tester_id) == user_id:
            await interaction.response.send_message(
                "❌ **You started this queue, so you can't join it as a player.**\n\n"
                "You can still use your queue to test other players.",
                ephemeral=True
            )
            return

        # -------------------------------------------------
        # 24-hour cooldown for THIS gamemode only.
        # -------------------------------------------------

        if user_is_restricted(interaction.user):
            await interaction.response.send_message(
                "🚫 **You are Restricted.**\n\n"
                "You cannot join any tier-testing queue while you have "
                "the **Restricted** role.\n\n"
                "Please contact BladeTiers staff if you believe this is a mistake.",
                ephemeral=True
            )
            return

        cooldown_remaining = get_test_cooldown_remaining(
            interaction.user.id,
            self.gamemode
        )

        if cooldown_remaining > 0:
            await interaction.response.send_message(
                "⏳ **You are on a testing cooldown for this gamemode.**\n\n"
                f"You recently completed a **{self.gamemode.title()}** tier test.\n"
                "You must wait 4 days before joining this gamemode again.\n\n"
                f"**Time remaining:** `{format_test_cooldown(cooldown_remaining)}`\n\n"
                "You can still join other gamemodes that aren't on cooldown.",
                ephemeral=True
            )
            return

        # -------------------------------------------------
        # JOIN = move this user from waitlist to active queue.
        # Request Test only puts users on the waitlist.
        # -------------------------------------------------

        if any(
            str(entry.get("user_id")) == user_id
            for entry in queue[self.gamemode]
        ):
            await interaction.response.send_message(
                "⚠️ **You're already in this queue!**",
                ephemeral=True
            )
            return

        waitlist_entry = next(
            (
                entry for entry in queue[waitlist_key]
                if str(entry.get("user_id")) == user_id
            ),
            None
        )

        if waitlist_entry is None:
            await interaction.response.send_message(
                f"❌ You're not on the **{self.gamemode.title()} waitlist**.\n\n"
                "Use **Request Test** first.",
                ephemeral=True
            )
            return

        # Maximum 30 players per active queue.
        if len(queue[self.gamemode]) >= 30:
            await interaction.response.send_message(
                f"❌ **This {self.gamemode.title()} queue is full!**\n\n"
                "**Maximum:** `30/30` players.",
                ephemeral=True
            )
            return

        # Save whether this queue was empty BEFORE joining.
        was_empty = len(queue[self.gamemode]) == 0

        # Remove only this user from the waitlist.
        queue[waitlist_key] = [
            entry for entry in queue[waitlist_key]
            if str(entry.get("user_id")) != user_id
        ]

        # Add this user to the active queue.
        queue[self.gamemode].append({
            "user_id": user_id,
            "username": username,
            "region": region
        })

        save_queue(queue)

        if role not in interaction.user.roles:
            try:
                await interaction.user.add_roles(
                    role,
                    reason=f"Joined {self.gamemode.title()} queue"
                )
            except discord.Forbidden:
                pass

        position = len(queue[self.gamemode])

        await interaction.response.send_message(
            f"✅ **You joined the {self.gamemode.title()} queue!**\n\n"
            f"**Position:** `#{position}`\n"
            f"**Username:** `{username}`\n"
            f"**Region:** `{region}`",
            ephemeral=True
        )

        # -------------------------------------------------
        # DM ONLY the person who becomes #1
        # -------------------------------------------------

        if was_empty:
            try:
                await interaction.user.send(
                    f"🧪 You're **#1** in the "
                    f"**{self.gamemode.title()} tier-test queue!**"
                )
            except (
                discord.Forbidden,
                discord.HTTPException
            ):
                pass

        await interaction.message.edit(
            embed=await build_queue_embed(
                interaction.guild,
                self.gamemode
            ),
            view=self
        )

    async def take_one_button(
        self,
        interaction: discord.Interaction,
        button: discord.ui.Button
    ):
        try:
            await interaction.response.defer(ephemeral=True)
        except discord.InteractionResponded:
            pass

        if interaction.guild is None:
            await interaction.followup.send(
                "❌ This can only be used inside a server.",
                ephemeral=True
            )
            return

        async with queue_take_lock:

            queue = load_queue()

            queue.setdefault(
                self.gamemode,
                []
            )

            # -------------------------------------------------
            # ONLY THE TESTER WHO OPENED THIS QUEUE
            # -------------------------------------------------

            active_tester_id = get_active_tester(
                self.gamemode
            )

            if not active_tester_id:
                await interaction.followup.send(
                    "❌ **No tester is assigned to this queue.**",
                    ephemeral=True
                )
                return

            if str(interaction.user.id) != str(
                active_tester_id
            ):
                await interaction.followup.send(
                    "❌ **Only the tester who opened this queue "
                    "can Take #1.**",
                    ephemeral=True
                )
                return

            if not queue[self.gamemode]:
                await interaction.followup.send(
                    "❌ **The queue is empty.**",
                    ephemeral=True
                )
                return

            player_entry = dict(
                queue[self.gamemode][0]
            )

            player_id = str(
                player_entry["user_id"]
            )

            username = player_entry.get(
                "username",
                "Unknown"
            )

            # -------------------------------------------------
            # Move #1 into currently testing.
            # -------------------------------------------------

            queue[self.gamemode] = [
                entry
                for entry in queue[self.gamemode]
                if str(entry.get("user_id")) != player_id
            ]

            # Save immediately so the player is really gone
            # from #1 before the public panel is rebuilt.
            save_queue(queue)

            # IMPORTANT:
            # Do NOT save currently_testing yet.
            # The ticket must be created successfully first.
            #
            # This prevents a bot restart/crash between queue
            # state saving and ticket creation from leaving a
            # stale *_currently_testing entry behind.
            #
            # The tester remains the person who ran /openqueue.

            # -------------------------------------------------
            # Remove queue role.
            # -------------------------------------------------

            try:
                role_name, _ = QUEUE_CONFIG[
                    self.gamemode
                ]

                player = interaction.guild.get_member(
                    int(player_id)
                )

                if player is None:
                    player = await interaction.guild.fetch_member(
                        int(player_id)
                    )

                role = discord.utils.get(
                    interaction.guild.roles,
                    name=role_name
                )

                if role and role in player.roles:
                    await player.remove_roles(
                        role,
                        reason=(
                            f"Taken for {self.gamemode.title()} "
                            "tier test"
                        )
                    )

            except (
                discord.NotFound,
                discord.Forbidden,
                discord.HTTPException,
                ValueError,
                TypeError
            ):
                pass

            # -------------------------------------------------
            # Create private ticket.
            # -------------------------------------------------

            try:
                ticket = await create_tier_test_ticket(
                    interaction.guild,
                    self.gamemode,
                    interaction.user,
                    player_entry
                )

                # Add this player to Currently Testing only
                # AFTER the ticket was created successfully.
                queue = load_queue()

                current_key = (
                    f"{self.gamemode}_currently_testing"
                )

                currently_testing = queue.get(
                    current_key,
                    []
                )

                if isinstance(currently_testing, str):
                    currently_testing = [currently_testing]

                if not isinstance(currently_testing, list):
                    currently_testing = []

                if not any(
                    clean_username(str(name))
                    == clean_username(str(username))
                    for name in currently_testing
                ):
                    currently_testing.append(username)

                queue[current_key] = currently_testing
                save_queue(queue)

            except Exception as error:
                import traceback
                print(
                    f"❌ Failed creating tier-test ticket: "
                    f"{type(error).__name__}: {error}",
                    flush=True
                )
                traceback.print_exc()

                queue = load_queue()

                queue.setdefault(
                    self.gamemode,
                    []
                )

                queue[self.gamemode].insert(
                    0,
                    player_entry
                )

                save_queue(queue)

                await interaction.followup.send(
                    "❌ **Couldn't create the testing ticket.**\n"
                    "The player was returned to #1.",
                    ephemeral=True
                )
                return

            # -------------------------------------------------
            # Update queue panel.
            # -------------------------------------------------

            await interaction.followup.send(
                f"🎯 **You took #1 — {username}!**\n"
                f"🎫 Ticket: {ticket.mention}",
                ephemeral=True
            )

            try:
                await interaction.message.edit(
                    embed=await build_queue_embed(
                        interaction.guild,
                        self.gamemode
                    ),
                    view=self
                )

            except (
                discord.NotFound,
                discord.Forbidden,
                discord.HTTPException
            ):
                pass


    @discord.ui.button(
        label="Leave",
        style=discord.ButtonStyle.danger,
