class StaffApplicationReviewView(discord.ui.View):
    def __init__(self, applicant_id):
        super().__init__(timeout=None)
        self.applicant_id = applicant_id

    async def decide(self, interaction, accepted):
        if not interaction.guild or (
            not interaction.user.guild_permissions.administrator
            and not has_role(interaction.user, "Senior Mod")
        ):
            return await interaction.response.send_message(
                "❌ Only Senior Mods or Administrators can review staff applications.",
                ephemeral=True
            )
        if self.accept.disabled or self.reject.disabled:
            return await interaction.response.send_message(
                "This application has already been reviewed.", ephemeral=True
            )
        self.accept.disabled = True
        self.reject.disabled = True
        embed = interaction.message.embeds[0] if interaction.message.embeds else discord.Embed(
            title="Staff Application"
        )
        embed.color = discord.Color.green() if accepted else discord.Color.red()
        embed.add_field(
            name="Application Decision",
            value=f"{'✅ Accepted' if accepted else '❌ Rejected'} by {interaction.user.mention}",
            inline=False
        )
        await interaction.response.edit_message(embed=embed, view=self)
        try:
            member = interaction.guild.get_member(self.applicant_id)
            if member is None:
                member = await interaction.guild.fetch_member(self.applicant_id)
            if accepted:
                await member.send(
                    "🎉 **BladeTiers Staff Application Update**\n\n"
                    "Good news! Your staff application has been **accepted**. "
                    "The team will share any next steps with you. Thank you for your interest in helping BladeTiers!"
                )
            else:
                await member.send(
                    "Hello! Thank you for taking the time to apply for the BladeTiers staff team. "
                    "After reviewing your application, we're sorry to let you know that it has **not been accepted at this time**. "
                    "We appreciate your interest in helping the community, and we encourage you to keep contributing. "
                    "Thank you for understanding!"
                )
        except Exception:
            pass

    @discord.ui.button(label="Accept", style=discord.ButtonStyle.success, emoji="✅")
    async def accept(self, interaction, button):
        await self.decide(interaction, True)

    @discord.ui.button(label="Reject", style=discord.ButtonStyle.danger, emoji="❌")
    async def reject(self, interaction, button):
        await self.decide(interaction, False)


