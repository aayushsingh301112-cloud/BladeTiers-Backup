def save_player_tier(username, gamemode, tier):
    if TIERS_FILE.exists():
        try:
            with open(TIERS_FILE, "r", encoding="utf-8") as f:
                tiers = json.load(f)
        except Exception:
            tiers = {}
    else:
        tiers = {}

    player_key = clean_username(username)
    mode_key = gamemode.strip().lower()

    if player_key not in tiers:
        tiers[player_key] = {}

    tiers[player_key][mode_key] = tier.upper()

    with open(TIERS_FILE, "w", encoding="utf-8") as f:
        json.dump(tiers, f, indent=2)


def get_player_tier(username, gamemode):
    if not TIERS_FILE.exists():
        return "Unranked"

    try:
        with open(
            TIERS_FILE,
            "r",
            encoding="utf-8"
        ) as f:
            tiers = json.load(f)
    except Exception:
        return "Unranked"

    return (
        tiers
        .get(clean_username(username), {})
        .get(gamemode.strip().lower(), "Unranked")
    )


