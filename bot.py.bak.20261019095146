        return await interaction.response.send_message(
            "You are not authorized to use this command.",
            ephemeral=True
        )

    BLACKOUT_ENABLED = mode.value == "on"

    BLACKOUT_FILE.write_text(json.dumps(
        {"enabled": BLACKOUT_ENABLED},
