class TesterAnswerModal(discord.ui.Modal):
    def __init__(self, application_view):
        self.application_view = application_view
        number = application_view.question_index + 1

        super().__init__(title=f"Tester Application - Q{number}/10")

        self.answer = discord.ui.TextInput(
            label=f"Question {number}",
            placeholder="Write your answer here...",
            style=discord.TextStyle.paragraph,
            required=True,
            min_length=1,
            max_length=4000,
        )

        self.add_item(self.answer)

    async def on_submit(self, interaction: discord.Interaction):
        view = self.application_view

        if interaction.user.id != view.applicant.id:
            await interaction.response.send_message(
                "This application is not yours.",
                ephemeral=True,
            )
            return

        answer = str(self.answer.value).strip()

        if not answer:
            await interaction.response.send_message(
                "Please enter an answer.",
                ephemeral=True,
            )
            return

        view.answers.append(answer)
        view.question_index += 1

        if view.question_index >= len(TESTER_APPLICATION_QUESTIONS):
            await interaction.response.defer()

            log_channel = interaction.guild.get_channel(
                1551115853624250518
            )
            if log_channel is None:
                try:
                    log_channel = await interaction.guild.fetch_channel(
                        1551115853624250518
                    )
                except discord.HTTPException:
                    log_channel = None

            if log_channel is not None:
                embed = discord.Embed(
                    title="Tester Application",
                    description=(
                        f"Applicant: {view.applicant.mention}\n"
                        f"Started by: {view.started_by.mention}"
                    ),
                    color=discord.Color.blurple(),
                    timestamp=discord.utils.utcnow(),
                )

                for i, question in enumerate(
                    TESTER_APPLICATION_QUESTIONS,
                    start=1,
                ):
                    answer_text = view.answers[i - 1]

                    if len(answer_text) > 1024:
                        answer_text = answer_text[:1021] + "..."

                    embed.add_field(
                        name=f"Q{i}. {question}",
                        value=answer_text,
                        inline=False,
                    )

                embed.set_footer(
                    text=f"Applicant ID: {view.applicant.id}"
                )

                review_view = TesterApplicationReviewView(
                    interaction.guild,
                    view.applicant,
                )
                await log_channel.send(embed=embed, view=review_view)

            await view.message.edit(
                content=(
                    "Tester application completed.\n"
                    "Your answers have been sent to the staff team."
                ),
                embed=None,
                view=None,
            )

            ACTIVE_TESTER_APPLICATIONS.pop(
                view.applicant.id,
                None,
            )
            return

        await interaction.response.defer()

        await view.message.edit(
            embed=view.build_embed(),
            view=view,
        )


class TesterApplicationReviewView(discord.ui.View):
    def __init__(self, guild, applicant):
        super().__init__(timeout=None)
        self.guild = guild
        self.applicant = applicant

        tick = discord.utils.get(guild.emojis, name="tick")
        denied = discord.utils.get(guild.emojis, name="denied")

        accept = discord.ui.Button(
            label="Accept",
            style=discord.ButtonStyle.success,
            emoji=tick,
        )
        reject = discord.ui.Button(
            label="Denied",
            style=discord.ButtonStyle.danger,
            emoji=denied,
        )

        accept.callback = self.accept_callback
        reject.callback = self.denied_callback
        self.add_item(accept)
        self.add_item(reject)

    async def review(self, interaction, accepted):
        helper = discord.utils.get(
            interaction.guild.roles, name="Discord Helper"
        )
        allowed = (
            interaction.user.guild_permissions.administrator
            or (helper is not None and helper in interaction.user.roles)
        )

        if not allowed:
            await interaction.response.send_message(
                "You need Discord Helper or Administrator permission "
                "to review applications.",
                ephemeral=True,
            )
            return

        if self.is_finished():
            await interaction.response.send_message(
                "This application has already been reviewed.",
                ephemeral=True,
            )
            return

        # Disable both buttons after a decision.
        for item in self.children:
            item.disabled = True

        embed = interaction.message.embeds[0].copy()
        decision = "ACCEPTED" if accepted else "DENIED"
        embed.title = f"Tester Application — {decision}"
        embed.color = (
            discord.Color.green() if accepted else discord.Color.red()
        )
        embed.add_field(
            name="Review decision",
            value=f"{decision} by {interaction.user.mention}",
            inline=False,
        )

        self.stop()
        await interaction.response.edit_message(embed=embed, view=self)

    async def accept_callback(self, interaction):
        await self.review(interaction, True)

    async def denied_callback(self, interaction):
        await self.review(interaction, False)
        if not interaction.response.is_done():
            return

        # Send a rejection DM only when the application is denied.
        try:
            await self.applicant.send(
                "## Sorry To Say But You Have Failed Your Apply for Tester Applications\n\n"
                "### Better luck next time !"
            )
        except discord.Forbidden:
            # The applicant has DMs disabled or is blocking server DMs.
            pass
        except discord.HTTPException:
            pass


