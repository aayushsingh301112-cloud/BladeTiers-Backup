TIER_ROLE_GAMEMODES = {
    "vanilla": "Vanilla",
    "uhc": "UHC",
    "pot": "Pot",
    "nethop": "NethOP",
    "nethpot": "NethOP",
    "smp": "SMP",
    "sword": "Sword",
    "axe": "Axe",
    "mace": "Mace",
}

TIER_ROLE_TIERS = {
    "LT5", "HT5",
    "LT4", "HT4",
    "LT3", "HT3",
    "LT2", "HT2",
    "LT1", "HT1",
}


async def sync_all_tier_roles():
    print("🔄 Starting hourly Blade Tiers role sync...")

    try:
        guild = bot.get_guild(int(GUILD_ID))

        if guild is None:
            guild = await bot.fetch_guild(int(GUILD_ID))

        # Fetch the current role list once.
        roles = await guild.fetch_roles()

        tier_roles = {
            role.id: role
            for role in roles
            if role.name.rsplit(" ", 1)[-1] in TIER_ROLE_TIERS
            and role.name.split(" ", 1)[0] in {
                "Vanilla", "UHC", "Pot", "NethOP",
                "SMP", "Sword", "Axe", "Mace"
            }
        }

        if len(tier_roles) != 80:
            print(
                f"⚠️ Hourly tier sync aborted: "
                f"found {len(tier_roles)}/80 tier roles."
            )
            return

        # Read registrations.
        registration_file = BASE_DIR / "registrations.txt"

        if not registration_file.exists():
            print("⚠️ Hourly tier sync skipped: registrations.txt missing.")
            return

        registrations = {}

        for line in registration_file.read_text(
            encoding="utf-8"
        ).splitlines():

            parts = line.strip().split("|")

            if len(parts) < 4:
                continue

            try:
                discord_id = int(parts[0])
            except ValueError:
                continue

            registrations[discord_id] = parts[1]

        # Read tiers.json once.
        if not TIERS_FILE.exists():
            print("⚠️ Hourly tier sync skipped: tiers.json missing.")
            return

        with open(TIERS_FILE, "r", encoding="utf-8") as f:
            tiers_data = json.load(f)

        tiers_lookup = {
            str(ign).lower(): data
            for ign, data in tiers_data.items()
        }

        checked = 0
        changed = 0
        skipped = 0
        errors = 0

        for discord_id, registered_ign in registrations.items():

            try:
                # Use cache first to avoid unnecessary HTTP requests.
                member = guild.get_member(discord_id)

                if member is None:
                    try:
                        member = await guild.fetch_member(discord_id)
                    except discord.NotFound:
                        skipped += 1
                        continue

                checked += 1

                tier_entry = tiers_lookup.get(
                    registered_ign.lower()
                )

                if not isinstance(tier_entry, dict):
                    skipped += 1
                    continue

                # Build the roles the player SHOULD have.
                desired_roles = set()

                for gamemode, tier in tier_entry.items():

                    display_gamemode = TIER_ROLE_GAMEMODES.get(
                        str(gamemode).lower()
                    )

                    if not display_gamemode:
                        continue

                    tier = str(tier).upper()

                    if tier not in TIER_ROLE_TIERS:
                        # No Discord role exists for MT/etc.,
                        # so don't touch anything for this entry.
                        continue

                    role_name = f"{display_gamemode} {tier}"

                    role = next(
                        (
                            r for r in tier_roles.values()
                            if r.name == role_name
                        ),
                        None
                    )

                    if role:
                        desired_roles.add(role)

                # Current Blade Tier roles only.
                current_roles = {
                    role
                    for role in member.roles
                    if role.id in tier_roles
                }

                roles_to_remove = current_roles - desired_roles
                roles_to_add = desired_roles - current_roles

                # Nothing changed -> do absolutely nothing.
                if not roles_to_remove and not roles_to_add:
                    continue

                print(
                    f"🔄 Syncing {registered_ign} "
                    f"({member.id})"
                )

                # IMPORTANT:
                # Remove old tier roles FIRST.
                if roles_to_remove:
                    await member.remove_roles(
                        *roles_to_remove,
                        reason="Hourly Blade Tiers role sync"
                    )

                    print(
                        "   Removed: " +
                        ", ".join(
                            sorted(r.name for r in roles_to_remove)
                        )
                    )

                # Then add the new tier roles.
                if roles_to_add:
                    await member.add_roles(
                        *roles_to_add,
                        reason="Hourly Blade Tiers role sync"
                    )

                    print(
                        "   Added: " +
                        ", ".join(
                            sorted(r.name for r in roles_to_add)
                        )
                    )

                changed += 1

                # Tiny delay only after an actual modification.
                await asyncio.sleep(0.15)

            except discord.Forbidden:
                errors += 1
                print(
                    f"⚠️ Permission error syncing "
                    f"{registered_ign} ({discord_id})"
                )

            except discord.HTTPException as e:
                errors += 1
                print(
                    f"⚠️ Discord HTTP error syncing "
                    f"{registered_ign} ({discord_id}): {e}"
                )

            except Exception as e:
                errors += 1
                print(
                    f"⚠️ Unexpected error syncing "
                    f"{registered_ign} ({discord_id}): {e}"
                )

        print(
            f"✅ Hourly tier sync complete | "
            f"Checked: {checked} | "
            f"Changed: {changed} | "
            f"Skipped: {skipped} | "
            f"Errors: {errors}"
        )

    except Exception as e:
        # NEVER let the background task kill the bot.
        print(f"🚨 Hourly tier sync failed safely: {e}")


@tasks.loop(hours=1)
async def hourly_tier_role_sync():
    await sync_all_tier_roles()


@hourly_tier_role_sync.before_loop
async def before_hourly_tier_role_sync():
    await bot.wait_until_ready()

    # First check happens one hour after startup.
    await asyncio.sleep(3600)



