class TierResultView(discord.ui.View):
    def __init__(
        self,
        gamemode,
        tester_id,
        player_entry
    ):
        super().__init__(timeout=None)

        self.gamemode = gamemode
        self.tester_id = int(tester_id)
        self.player_entry = dict(player_entry)

        # Testers can award up to LT3 only.
        # Higher tiers remain valid elsewhere in the bot.
        tiers = [
            "LT5",
            "HT5",
            "LT4",
            "HT4",
            "LT3"
        ]

        for tier in tiers:
            button = discord.ui.Button(
                label=f"{gamemode.title()} {tier}",
                style=discord.ButtonStyle.success,
                custom_id=f"tier_result:{gamemode}:{tier}"
            )

            async def callback(
                interaction,
                selected_tier=tier
            ):
                await self.handle_result(
                    interaction,
                    selected_tier
                )

            button.callback = callback
            self.add_item(button)

    @discord.ui.button(
        label="No Result",
        style=discord.ButtonStyle.danger,
        emoji="❌",
        row=2,
        custom_id="tierbot_no_result"
    )
    async def no_result_button(
        self,
        interaction: discord.Interaction,
        button: discord.ui.Button
    ):
        if interaction.guild is None:
            await interaction.response.send_message(
                "❌ This can only be used inside a server.",
                ephemeral=True
            )
            return

        if interaction.user.id != self.tester_id:
            await interaction.response.send_message(
                "❌ **Only the assigned tester can use No Result.**",
                ephemeral=True
            )
            return

        queue = load_queue()
        current_key = f"{self.gamemode}_currently_testing"

        currently_testing = queue.get(
            current_key,
            []
        )

        if isinstance(currently_testing, str):
            currently_testing = [currently_testing]

        username = self.player_entry.get(
            "username",
            "Unknown"
        )

        if not currently_testing:
            await interaction.response.send_message(
                "❌ **This test is no longer active.**",
                ephemeral=True
            )
            return

        if not any(
            clean_username(str(name))
            == clean_username(str(username))
            for name in currently_testing
        ):
            await interaction.response.send_message(
                "❌ **This ticket is no longer active.**",
                ephemeral=True
            )
            return

        # Remove ONLY this player's active test.
        currently_testing = [
            name
            for name in currently_testing
            if clean_username(str(name))
            != clean_username(str(username))
        ]

        if currently_testing:
            queue[current_key] = currently_testing
        else:
            queue.pop(current_key, None)

        save_queue(queue)

        await interaction.response.defer()

        await asyncio.sleep(3)

        try:
            await interaction.channel.delete(
                reason="Tier test cancelled - No Result"
            )
        except (
            discord.NotFound,
            discord.Forbidden,
            discord.HTTPException
        ):
            pass

    async def handle_result(
        self,
        interaction: discord.Interaction,
        new_tier: str
    ):
        # ACKNOWLEDGE IMMEDIATELY.
        # This prevents "BladeTiers didn't respond in time."
        try:
            await interaction.response.defer()
        except discord.InteractionResponded:
            pass

        try:
            if interaction.guild is None:
                await interaction.followup.send(
                    "❌ This can only be used inside a server.",
                    ephemeral=True
                )
                return

            # Only the assigned tester can give the result.
            if interaction.user.id != self.tester_id:
                await interaction.followup.send(
                    "❌ **Only the assigned tester can give this result.**",
                    ephemeral=True
                )
                return

            queue = load_queue()

            testing_key = (
                f"{self.gamemode}_currently_testing"
            )

            currently_testing = queue.get(
                testing_key,
                []
            )

            if isinstance(currently_testing, str):
                currently_testing = [currently_testing]

            username = self.player_entry.get(
                "username",
                "Unknown"
            )

            if not currently_testing:
                await interaction.followup.send(
                    "❌ **This tier test is no longer active.**",
                    ephemeral=True
                )
                return

            if not any(
                clean_username(str(name))
                == clean_username(str(username))
                for name in currently_testing
            ):
                await interaction.followup.send(
                    "❌ **This ticket is no longer active.**",
                    ephemeral=True
                )
                return

            # Find result channel.
            result_channel = discord.utils.get(
                interaction.guild.text_channels,
                name="🏆┃result"
            )

            if result_channel is None:
                result_channel = discord.utils.get(
                    interaction.guild.text_channels,
                    name="result"
                )

            if result_channel is None:
                await interaction.followup.send(
                    "❌ **`🏆┃result` channel was not found.**",
                    ephemeral=True
                )
                return

            region = self.player_entry.get(
                "region",
                "Unknown"
            )

            player_id = str(
                self.player_entry.get(
                    "user_id"
                )
            )

            previous_tier = get_player_tier(
                username,
                self.gamemode
            )

            new_tier = str(
                new_tier
            ).upper()

            registration = get_registration(int(player_id))
            account_type = str(registration[3]).lower() if registration and len(registration) >= 4 else "cracked"
            skin_path = SKINS_DIR / f"{clean_username(username)}.png"
            image_found = skin_path.is_file()
            # Result embed.
            if "5" in new_tier:
                embed_color = discord.Color.from_rgb(
                    140, 255, 0
                )
            elif "4" in new_tier:
                embed_color = discord.Color.from_rgb(
                    255, 230, 0
                )
            elif "3" in new_tier:
                embed_color = discord.Color.from_rgb(
                    255, 255, 255
                )
            elif "2" in new_tier:
                embed_color = discord.Color.from_rgb(
                    255, 180, 0
                )
            elif "1" in new_tier:
                embed_color = discord.Color.from_rgb(
                    70, 140, 255
                )
            else:
                embed_color = discord.Color.blurple()

            embed = discord.Embed(
                title=(
                    f"🏆 Tier Test Result — "
                    f"{username}"
                ),
                color=embed_color
            )

            if account_type == "premium":
                embed.set_thumbnail(
                    url=f"https://mc-heads.net/avatar/{clean_username(username)}/256"
                )
                embed.add_field(
                    name="Player Face",
                    value="✅ Premium skin loaded from MCHeads",
                    inline=False
                )

            embed.add_field(
                name="Tester",
                value=interaction.user.display_name,
                inline=False
            )

            embed.add_field(
                name="Region",
                value=region,
                inline=False
            )

            embed.add_field(
                name="Username",
                value=username,
                inline=False
            )

            embed.add_field(
                name="Gamemode",
                value=self.gamemode,
                inline=False
            )

            embed.add_field(
                name="Previous Tier",
                value=previous_tier,
                inline=False
            )

            embed.add_field(
                name="New Tier",
                value=new_tier,
                inline=False
            )

            result_file = None

            if image_found:
                embed.add_field(
                    name="Player Face",
                    value="✅ User image found",
                    inline=False
                )

                embed.set_thumbnail(
                    url="attachment://player-face.png"
                )

                with open(
                    skin_path,
                    "rb"
                ) as face_file:
                    face_image = create_face(
                        face_file.read()
                    )

                face_buffer = io.BytesIO()

                face_image.save(
                    face_buffer,
                    format="PNG"
                )

                face_buffer.seek(0)

                result_file = discord.File(
                    face_buffer,
                    filename="player-face.png"
                )

            else:
                embed.add_field(
                    name="Player Face",
                    value="❌ Error - user image not found",
                    inline=False
                )

            # Get player for mention.
            player = None

            try:
                player = interaction.guild.get_member(
                    int(player_id)
                )

                if player is None:
                    player = await interaction.guild.fetch_member(
                        int(player_id)
                    )

            except (
                discord.NotFound,
                discord.HTTPException,
                ValueError,
                TypeError
            ):
                pass

            if player is not None:
                result_content = player.mention
            else:
                result_content = f"<@{player_id}>"

            # POST RESULT FIRST.
            if result_file is not None:
                result_message = await result_channel.send(
                    content=result_content,
                    embed=embed,
                    file=result_file,
                    allowed_mentions=discord.AllowedMentions(
                        users=True
                    )
                )
            else:
                result_message = await result_channel.send(
                    content=result_content,
                    embed=embed,
                    allowed_mentions=discord.AllowedMentions(
                        users=True
                    )
                )

            # Exact requested reactions.
            for emoji in (
                "🏆",
                "🎉",
                "🔥",
                "👍",
                "💀"
            ):
                try:
                    await result_message.add_reaction(
                        emoji
                    )
                except (
                    discord.Forbidden,
                    discord.HTTPException
                ):
                    pass

            # Record tester stats only after the result was successfully posted.
            record_tester_result(
                self.tester_id,
                interaction.user.display_name,
                self.gamemode
            )

            # Save tier ONLY after result successfully posted.
            save_player_tier(
                username,
                self.gamemode,
                new_tier
            )

            # Start a 24-hour cooldown ONLY for the
            # gamemode that was successfully tested.
            set_test_cooldown(
                self.player_entry.get(
                    "user_id",
                    interaction.user.id
                ),
                self.gamemode
            )

            # Finish ONLY this player's test.
            currently_testing = queue.get(
                testing_key,
                []
            )

            if isinstance(currently_testing, str):
                currently_testing = [currently_testing]

            currently_testing = [
                name
                for name in currently_testing
                if clean_username(str(name))
                != clean_username(str(username))
            ]

            if currently_testing:
                queue[testing_key] = currently_testing
            else:
                queue.pop(testing_key, None)

            save_queue(queue)

            # Promote next #1.
            # Reuse the queue already loaded above.
            entries = queue.get(
                self.gamemode,
                []
            )

            next_player = None

            if isinstance(entries, list) and entries:
                next_player = entries[0]

            if next_player:
                try:
                    next_member = (
                        interaction.guild.get_member(
                            int(next_player["user_id"])
                        )
                    )

                    if next_member is None:
                        next_member = (
                            await interaction.guild.fetch_member(
                                int(next_player["user_id"])
                            )
                        )

                    await next_member.send(
                        f"🎯 **You're now #1 in the "
                        f"{self.gamemode.title()} tier-test queue!**"
                    )

                except (
                    discord.NotFound,
                    discord.Forbidden,
                    discord.HTTPException,
                    ValueError,
                    TypeError
                ):
                    pass

            # Refresh the queue panel directly.
            try:
                _, queue_channel_name = QUEUE_CONFIG[
                    self.gamemode
                ]

                queue_channel = discord.utils.get(
                    interaction.guild.text_channels,
                    name=queue_channel_name
                )

                queue_data = load_queue()
                panel_message_id = queue_data.get(
                    f"{self.gamemode}_panel_message_id"
                )

                if queue_channel is not None and panel_message_id:
                    try:
                        panel_message = await queue_channel.fetch_message(
                            int(panel_message_id)
                        )

                        await panel_message.edit(
                            embed=await build_queue_embed(
                                interaction.guild,
                                self.gamemode
                            ),
                            view=QueuePanelView(
                                self.gamemode
                            )
                        )

                    except (
                        discord.NotFound,
                        discord.Forbidden,
                        discord.HTTPException,
                        ValueError,
                        TypeError
                    ):
                        pass

            except Exception as error:
                print(
                    f"⚠️ Queue panel refresh failed: "
                    f"{error}"
                )

            # Tell tester the result worked.
            await interaction.followup.send(
                "✅ **Result submitted!**\n"
                "🏆 Result posted successfully.\n"
                "🗑️ **Ticket deleting in 3 seconds...**",
                ephemeral=False
            )

            await asyncio.sleep(3)

            try:
                await interaction.channel.delete(
                    reason="Tier test completed"
                )
            except (
                discord.NotFound,
                discord.Forbidden,
                discord.HTTPException
            ):
                pass

        except Exception as error:
            print(
                "❌ Tier result button error:"
            )
            print(
                repr(error)
            )

            try:
                await interaction.followup.send(
                    "❌ **Something went wrong while submitting "
                    "the result.**\n"
                    "Check the bot console for the exact error.",
                    ephemeral=True
                )
            except Exception:
                pass

async def send_skin_to_private_channel(
    username,
    region,
    account_type,
    skin_bytes=None
):
    """Send registration/skin information to #skins-thing."""
    try:
        channel = discord.utils.get(
            bot.get_all_channels(),
            name=SKINS_CHANNEL_NAME
        )

        if channel is None:
            print(f"⚠️ #{SKINS_CHANNEL_NAME} channel not found.")
            return False

        import io

        account = str(account_type).lower()
        account = "premium" if "premium" in account else "cracked"

        content = (
            f"Name: {username}\n"
            f"Account Type: {account}"
        )

        if skin_bytes is not None:
            file = discord.File(
                io.BytesIO(skin_bytes),
                filename=f"{clean_username(username)}.png"
            )

            await channel.send(
                content=content + "\nSkin: ⬇️",
                file=file
            )
        else:
            await channel.send(content=content)

        print(
            f"✅ Sent to #{SKINS_CHANNEL_NAME} | "
            f"{username} | {account}"
        )
        return True

    except Exception as error:
        print(
            f"❌ Failed to send to #{SKINS_CHANNEL_NAME}: {error}"
        )
        return False


class RegisterModal(discord.ui.Modal):
    def __init__(self, account_type):
        self.account_type = account_type

        super().__init__(
            title="BladeTiers Profile Registration — Step 2/2"
        )

        self.username = discord.ui.TextInput(
            label="In-Game Username",
            placeholder="Example: MC_Vidz",
            required=True,
            max_length=16
        )

        self.region = discord.ui.TextInput(
            label="Region",
            placeholder="AS / EU / NA / SA / OCE / MEA",
            required=True,
            max_length=3
        )

        self.add_item(self.username)
        self.add_item(self.region)

    async def on_submit(
        self,
        interaction: discord.Interaction
    ):
        username = str(self.username.value).strip()
        region = str(self.region.value).strip().upper()

        if self.account_type not in ACCOUNT_TYPES:
            await interaction.response.send_message(
                "❌ Invalid Minecraft account type.",
                ephemeral=True
            )
            return

        allowed_regions = {
            "AS",
            "EU",
            "NA",
            "SA",
            "OCE",
            "MEA"
        }

        if region not in allowed_regions:
            await interaction.response.send_message(
                "❌ Invalid region.\n\n"
                "Use one of: `AS`, `EU`, `NA`, `SA`, `OCE`, `MEA`.",
                ephemeral=True
            )
            return

        safe_username = clean_username(username)

        if not safe_username or safe_username != username:
            await interaction.response.send_message(
                "❌ Invalid Minecraft username.\n\n"
                "Use only letters, numbers, `_` or `-`.",
                ephemeral=True
            )
            return

        registration_file = BASE_DIR / "registrations.txt"

        existing = []

        if registration_file.exists():
            with open(
                registration_file,
                "r",
                encoding="utf-8"
            ) as f:
                for line in f:
                    line = line.rstrip("\n")

                    if not line:
                        continue

                    parts = line.split("|")

                    if (
                        len(parts) >= 3
                        and parts[0] != str(interaction.user.id)
                    ):
                        existing.append(line)

        with open(
            registration_file,
            "w",
            encoding="utf-8"
        ) as f:
            for line in existing:
                f.write(line + "\n")

            f.write(
                f"{interaction.user.id}|"
                f"{username}|"
                f"{region}|"
                f"{self.account_type}\n"
            )

        account_name = ACCOUNT_TYPES[self.account_type]

        if self.account_type == "premium":
            extra = (
                "🟦 **Premium profile:** Your registration details "
                "have been sent to the private testing channel."
            )
            registration_view = None
        else:
            extra = (
                "🖼️ **Cracked profile:** your Minecraft skin is required "
                "before you can request a tier test.\n\n"
                "Upload your skin directly using the button below."
            )
            registration_view = SkinUploadView()

        await interaction.response.send_message(
            "✅ **BladeTiers Registration Complete!**\n\n"
            f"**Account Type:** `{account_name}`\n"
            f"**In-Game Username:** `{username}`\n"
            f"**Region:** `{region}`\n\n"
            f"{extra}",
            view=registration_view,
            ephemeral=True
        )

        if self.account_type == "premium":
            await send_skin_to_private_channel(
                username,
                region,
                account_name,
                None
            )


