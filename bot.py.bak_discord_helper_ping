            "sword": ["sword~2", "sword"],
            "vanilla": ["vanilla"],
            "smp": ["smp"],
            "pot": ["pot"],
            "mace": ["mace"],
            "nethop": ["nethop"],
            "uhc": ["uhc"],
        }

        def get_emoji(mode):
            if guild is None:
                return None
            for name in emoji_names.get(mode, []):
                emoji = discord.utils.get(guild.emojis, name=name)
                if emoji:
                    return str(emoji)
            return None

        options = [
            discord.SelectOption(label="Axe", value="axe", emoji=get_emoji("axe")),
            discord.SelectOption(label="Sword", value="sword", emoji=get_emoji("sword")),
            discord.SelectOption(label="Vanilla", value="vanilla", emoji=get_emoji("vanilla")),
            discord.SelectOption(label="SMP", value="smp", emoji=get_emoji("smp")),
            discord.SelectOption(label="Pot", value="pot", emoji=get_emoji("pot")),
            discord.SelectOption(label="Mace", value="mace", emoji=get_emoji("mace")),
            discord.SelectOption(label="Nethop", value="nethop", emoji=get_emoji("nethop")),
            discord.SelectOption(label="UHC", value="uhc", emoji=get_emoji("uhc")),
        ]

        super().__init__(
            placeholder="🎯 Select the gamemode you want to test...",
            min_values=1,
            max_values=1,
            options=options,
            custom_id="tierbot_test_gamemode"
        )

    async def callback(self, interaction: discord.Interaction):
        await interaction.response.defer(ephemeral=True)

        registration = get_registration(interaction.user.id)

        if registration is None:
            await interaction.followup.send(
                "❌ **You are not registered yet.**\n\n"
                "Please register first.",
                ephemeral=True
            )
            return

        gamemode = self.values[0]
        username = registration[1]
        region = registration[2]

        account_type = registration[3] if len(registration) >= 4 else "cracked"

        if account_type == "cracked":
            skin_path = SKINS_DIR / f"{clean_username(username)}.png"

            if not skin_path.is_file():
                await interaction.followup.send(
                    "🖼️ **Skin Upload Required**\n\n"
                    f"Your cracked account **`{username}`** does not have a "
                    "Minecraft skin uploaded yet.\n\n"
                    "Please use `/skinupload` and attach your skin file "
                    "directly from your computer.\n\n"
                    "After uploading it successfully, come back and click "
                    "**Request Test** again.",
                    ephemeral=True
                )
                return

        role_name, _ = QUEUE_CONFIG[gamemode]

        role = discord.utils.get(
            interaction.guild.roles,
            name=role_name
        )

        if role is None:
            await interaction.followup.send(
                f"❌ Queue role `{role_name}` was not found.",
                ephemeral=True
            )
            return

        if any(
            str(entry.get("user_id")) == str(interaction.user.id)
            for entry in load_queue().get(gamemode, [])
        ):
            await interaction.followup.send(
                f"⚠️ You're already in the "
                f"**{gamemode.title()} queue!**",
                ephemeral=True
            )
            return

        queue = load_queue()

        waitlist_key = f"{gamemode}_waitlist"
        queue.setdefault(waitlist_key, [])

        # Request Test = waitlist only.
        # Do NOT add the player to the active queue.
        if any(
            str(entry.get("user_id")) == str(interaction.user.id)
            for entry in queue[waitlist_key]
        ):
            await interaction.followup.send(
                f"⚠️ You're already on the "
                f"**{gamemode.title()} waitlist!**",
                ephemeral=True
            )
            return

        queue[waitlist_key].append({
            "user_id": str(interaction.user.id),
            "username": username,
            "region": region
        })

        save_queue(queue)

        try:
            if role not in interaction.user.roles:
                await interaction.user.add_roles(
                    role,
                    reason=f"Requested {gamemode.title()} tier test"
                )
        except discord.Forbidden:
            await interaction.followup.send(
                f"❌ I couldn't give you the `{role_name}` role.\n\n"
                "Please contact an administrator.",
                ephemeral=True
            )
            return

        await interaction.followup.send(
            f"✅ **Test Request Submitted!**\n\n"
            f"🎮 **Gamemode:** `{gamemode.title()}`\n"
            f"👤 **IGN:** `{username}`\n"
            f"🌍 **Region:** `{region}`\n\n"
            f"You have been given the `{role_name}` role.",
            ephemeral=True
        )



