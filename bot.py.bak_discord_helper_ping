@bot.tree.command(
    name="lookup",
    description="Look up a player's Minecraft IGN and Discord account.",
    guild=discord.Object(id=int(GUILD_ID))
)
@app_commands.describe(
    ign="The Minecraft IGN to look up."
)
async def lookup(
    interaction: discord.Interaction,
    ign: str
):
    target_ign = ign.strip().lower()

    if not target_ign:
        await interaction.response.send_message(
            "❌ Please provide a Minecraft IGN.",
            ephemeral=True
        )
        return

    registration_file = BASE_DIR / "registrations.txt"

    if not registration_file.exists():
        await interaction.response.send_message(
            "❌ No registration data is available.",
            ephemeral=True
        )
        return

    found = None

    try:
        with open(
            registration_file,
            "r",
            encoding="utf-8"
        ) as f:
            for line in f:
                parts = line.rstrip("\n").split("|")

                if len(parts) < 2:
                    continue

                discord_id = parts[0].strip()
                username = parts[1].strip()

                if username.lower() == target_ign:
                    region = parts[2].strip() if len(parts) >= 3 else "Unknown"
                    account_type = (
                        parts[3].strip().title()
                        if len(parts) >= 4
                        else "Cracked"
                    )

                    found = (
                        discord_id,
                        username,
                        region,
                        account_type
                    )
                    break

    except OSError:
        await interaction.response.send_message(
            "❌ Could not read registration data.",
            ephemeral=True
        )
        return

    if found is None:
        await interaction.response.send_message(
            f"❌ No registered player found with the IGN `{ign}`.",
            ephemeral=True
        )
        return

    discord_id, username, region, account_type = found

    try:
        discord_user = await bot.fetch_user(int(discord_id))
        discord_display = discord_user.mention
    except (
        discord.NotFound,
        discord.HTTPException,
        ValueError,
        TypeError
    ):
        discord_display = f"<@{discord_id}>"

    embed = discord.Embed(
        title="🔎 Player Lookup",
        description=f"Information for **{username}**",
        color=discord.Color.blurple()
    )

    embed.add_field(
        name="🎮 Minecraft IGN",
        value=f"`{username}`",
        inline=True
    )

    embed.add_field(
        name="💬 Discord",
        value=discord_display,
        inline=True
    )

    embed.add_field(
        name="🌎 Region",
        value=f"`{region}`",
        inline=True
    )

    embed.add_field(
        name="👤 Account Type",
        value=f"`{account_type}`",
        inline=True
    )

    embed.set_footer(
        text="BladeTiers Player Lookup"
    )

    await interaction.response.send_message(
        embed=embed,
        ephemeral=False
    )


