async def create_support_ticket(
    interaction: discord.Interaction,
    ticket_type: str
):
    if interaction.guild is None:
        return await interaction.response.send_message(
            "❌ This can only be used inside a server.",
            ephemeral=True
        )

    if ticket_type not in SUPPORT_TYPES:
        return await interaction.response.send_message(
            "❌ Invalid ticket type.",
            ephemeral=True
        )

    label,prefix=SUPPORT_TYPES[ticket_type]

    guild=interaction.guild
    user=interaction.user

    safe_username=clean_username(user.display_name).lower()
    if not safe_username:
        safe_username=f"user-{user.id}"

    # Prevent duplicate open tickets of the same type.
    category=discord.utils.get(
        guild.categories,
        name=SUPPORT_TICKET_CATEGORY
    )

    if category:
        for channel in category.text_channels:
            topic=channel.topic or ""
            if topic == f"support_ticket:{user.id}:{ticket_type}":
                return await interaction.response.send_message(
                    f"❌ You already have an open **{label}** ticket: {channel.mention}",
                    ephemeral=True
                )

    if category is None:
        try:
            category=await guild.create_category(
                SUPPORT_TICKET_CATEGORY,
                reason="BladeTiers support ticket category"
            )
        except discord.Forbidden:
            return await interaction.response.send_message(
                "❌ I don't have permission to create the support ticket category.",
                ephemeral=True
            )

    # Private permissions: support team can access tickets.
    overwrites={
        guild.default_role: discord.PermissionOverwrite(
            view_channel=False
        ),
        user: discord.PermissionOverwrite(
            view_channel=True,
            send_messages=True,
            read_message_history=True,
            attach_files=True,
            embed_links=True
        ),
        guild.me: discord.PermissionOverwrite(
            view_channel=True,
            send_messages=True,
            read_message_history=True,
            manage_channels=True,
            manage_messages=True
        )
    }

    helper_role = discord.utils.get(guild.roles, name="Discord Helper")
    if helper_role:
        overwrites[helper_role] = discord.PermissionOverwrite(
            view_channel=True,
            send_messages=True,
            read_message_history=True,
            attach_files=True,
            embed_links=True
        )

    ticket_name=f"{prefix}-{safe_username}"

    # Discord channel names have a 100 character limit.
    ticket_name=ticket_name[:100]

    try:
        channel=await guild.create_text_channel(
            name=ticket_name,
            category=category,
            overwrites=overwrites,
            topic=f"support_ticket:{user.id}:{ticket_type}",
            reason=f"BladeTiers {label} ticket"
        )
    except discord.Forbidden:
        return await interaction.response.send_message(
            "❌ I don't have permission to create the ticket.",
            ephemeral=True
        )
    except discord.HTTPException as error:
        return await interaction.response.send_message(
            f"❌ Failed to create ticket: `{error}`",
            ephemeral=True
        )

    embed=discord.Embed(
        title=f"🎫 {label}",
        description=(
            f"Welcome {user.mention}!\n\n"
            f"Your **{label}** ticket has been created.\n"
            "Please explain your issue/application clearly and "
            "wait for a member of the team to respond.\n\n"
            "🔒 Use the button below to close this ticket."
        ),
        color=discord.Color.blurple()
    )

    embed.set_footer(
        text="BladeTiers Support"
    )

    # Ping the ticket owner + Senior Tester + Developer/Admin.
    senior_tester_role = discord.utils.get(
        guild.roles,
        name="Senior Tester"
    )

    developer_admin_role = discord.utils.get(
        guild.roles,
        name="Developer/Admin"
    )

    mentions = [user.mention]

    if senior_tester_role:
        mentions.append(senior_tester_role.mention)

    if developer_admin_role:
        mentions.append(developer_admin_role.mention)

    await channel.send(
        content=" ".join(mentions),
        embed=embed,
        view=SupportCloseView(),
        allowed_mentions=discord.AllowedMentions(
            users=True,
            roles=True
        )
    )

    await interaction.response.send_message(
        f"✅ Your private ticket has been created: {channel.mention}",
        ephemeral=True
    )

    print(
        f"🎫 Support ticket created | "
        f"Type: {label} | User: {user} | Channel: {channel.name}"
    )


