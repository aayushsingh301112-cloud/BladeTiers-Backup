# ---------------------------------------------------------
# 24-hour PER-GAMEMODE test cooldown
#
# Stored in queue.json so cooldowns survive bot restarts.
# Each gamemode has its own independent cooldown.
# ---------------------------------------------------------

RESTRICTED_ROLE_NAME = "Restricted"


def user_is_restricted(member):
    return any(
        str(role.name).strip().lower() == RESTRICTED_ROLE_NAME.lower()
        for role in getattr(member, "roles", [])
    )


TEST_COOLDOWN_SECONDS = 24 * 60 * 60


def get_test_cooldown_remaining(user_id, gamemode):
    import time

    queue = load_queue()
    cooldowns = queue.get("test_cooldowns", {})

    user_cooldowns = cooldowns.get(str(user_id), {})

    if not isinstance(user_cooldowns, dict):
        return 0

    mode_key = str(gamemode).lower()
    expires_at = user_cooldowns.get(mode_key)

    if not expires_at:
        return 0

    remaining = float(expires_at) - time.time()

    if remaining <= 0:
        user_cooldowns.pop(mode_key, None)

        if user_cooldowns:
            cooldowns[str(user_id)] = user_cooldowns
        else:
            cooldowns.pop(str(user_id), None)

        if cooldowns:
            queue["test_cooldowns"] = cooldowns
        else:
            queue.pop("test_cooldowns", None)

        save_queue(queue)
        return 0

    return remaining


def set_test_cooldown(user_id, gamemode):
    import time

    queue = load_queue()
    cooldowns = queue.setdefault("test_cooldowns", {})

    user_cooldowns = cooldowns.setdefault(
        str(user_id),
        {}
    )

    user_cooldowns[str(gamemode).lower()] = (
        time.time() + TEST_COOLDOWN_SECONDS
    )

    save_queue(queue)


def format_test_cooldown(seconds):
    seconds = int(seconds)

    hours = seconds // 3600
    minutes = (seconds % 3600) // 60

    if hours > 0:
        return f"{hours}h {minutes}m"

    return f"{minutes}m"


