class SkinUploadModal(discord.ui.Modal):
    """Native Discord file-picker for cracked Minecraft skins."""

    def __init__(self):
        super().__init__(title="Upload Minecraft Skin")

        self.skin_file = discord.ui.FileUpload(
            custom_id="tierbot_skin_file",
            required=True,
            min_values=1,
            max_values=1
        )

        self.add_item(
            discord.ui.Label(
                text="Minecraft Skin",
                description="Upload your 64×64 or 128×128 PNG/JPG/JPEG skin.",
                component=self.skin_file
            )
        )

    async def on_submit(self, interaction: discord.Interaction):
        registration = get_registration(interaction.user.id)

        if registration is None:
            await interaction.response.send_message(
                "❌ **You are not registered yet.**\n\n"
                "Please use **Register / Update** first.",
                ephemeral=True
            )
            return

        username = registration[1]
        region = registration[2]
        account_type = (
            str(registration[3]).strip().lower()
            if len(registration) >= 4
            else "cracked"
        )

        if account_type == "premium":
            await interaction.response.send_message(
                "🟦 **Premium account detected.**\n\n"
                "Your Minecraft skin is handled automatically.",
                ephemeral=True
            )
            return

        files = self.skin_file.values

        if not files:
            await interaction.response.send_message(
                "❌ **No skin file was uploaded.**",
                ephemeral=True
            )
            return

        skin = files[0]

        if not skin.filename.lower().endswith((".png", ".jpg", ".jpeg")):
            await interaction.response.send_message(
                "❌ **Invalid file.**\n\n"
                "Please upload a PNG, JPG, or JPEG Minecraft skin.",
                ephemeral=True
            )
            return

        try:
            skin_data = await skin.read()

            img = Image.open(io.BytesIO(skin_data))
            img.load()

            if img.size not in ((64, 64), (128, 128)):
                raise ValueError(
                    f"Invalid skin size: {img.size}. "
                    "Minecraft skins must be 64×64 or 128×128."
                )

            img = img.convert("RGBA")

            SKINS_DIR.mkdir(parents=True, exist_ok=True)

            skin_path = SKINS_DIR / f"{clean_username(username)}.png"
            img.save(skin_path, "PNG")

        except Exception as error:
            print(
                f"SKIN GUI ERROR | User: {interaction.user} | "
                f"Type: {type(error).__name__} | Error: {error}",
                flush=True
            )

            await interaction.response.send_message(
                "❌ **Skin upload failed.**\n\n"
                f"`{type(error).__name__}: {error}`",
                ephemeral=True
            )
            return

        await interaction.response.send_message(
            "✅ **Minecraft skin uploaded successfully!**\n\n"
            f"**Username:** `{username}`\n"
            f"**Region:** `{region}`\n\n"
            "You can now use **Request Test**.",
            ephemeral=True
        )

        # Send the uploaded skin to the existing private review channel.
        try:
            review_buffer = io.BytesIO()
