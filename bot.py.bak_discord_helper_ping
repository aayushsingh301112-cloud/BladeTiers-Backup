class TesterAnswerModal(discord.ui.Modal):
    def __init__(self, application_view):
        self.application_view = application_view
        number = application_view.question_index + 1

        super().__init__(title=f"Tester Application - Q{number}/10")

        self.answer = discord.ui.TextInput(
            label=f"Question {number}",
            placeholder="Write your answer here...",
            style=discord.TextStyle.paragraph,
            required=True,
            min_length=1,
            max_length=4000,
        )

        self.add_item(self.answer)

    async def on_submit(self, interaction: discord.Interaction):
        view = self.application_view

        if interaction.user.id != view.applicant.id:
            await interaction.response.send_message(
                "This application is not yours.",
                ephemeral=True,
            )
            return

        answer = str(self.answer.value).strip()

        if not answer:
            await interaction.response.send_message(
                "Please enter an answer.",
                ephemeral=True,
            )
            return

        view.answers.append(answer)
        view.question_index += 1

        if view.question_index >= len(TESTER_APPLICATION_QUESTIONS):
            await interaction.response.defer()

            log_channel = discord.utils.get(
                interaction.guild.text_channels,
                name="apply-logs",
            )

            if log_channel is not None:
                embed = discord.Embed(
                    title="Tester Application",
                    description=(
                        f"Applicant: {view.applicant.mention}\n"
                        f"Started by: {view.started_by.mention}"
                    ),
                    color=discord.Color.blurple(),
                    timestamp=discord.utils.utcnow(),
                )

                for i, question in enumerate(
                    TESTER_APPLICATION_QUESTIONS,
                    start=1,
                ):
                    answer_text = view.answers[i - 1]

                    if len(answer_text) > 1024:
                        answer_text = answer_text[:1021] + "..."

                    embed.add_field(
                        name=f"Q{i}. {question}",
                        value=answer_text,
                        inline=False,
                    )

                embed.set_footer(
                    text=f"Applicant ID: {view.applicant.id}"
                )

                await log_channel.send(embed=embed)

            await view.message.edit(
                content=(
                    "Tester application completed.\n"
                    "Your answers have been sent to the staff team."
                ),
                embed=None,
                view=None,
            )

            ACTIVE_TESTER_APPLICATIONS.pop(
                view.applicant.id,
                None,
            )
            return

        await interaction.response.defer()

        await view.message.edit(
            embed=view.build_embed(),
            view=view,
        )


