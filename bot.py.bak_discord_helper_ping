        )
    ]
)
async def openqueue(
    interaction: discord.Interaction,
    gamemode: app_commands.Choice[str],
    server: str
):
    # ACK immediately so Discord does not expire the interaction.
    await interaction.response.defer(ephemeral=True)

    if interaction.guild is None:
        await interaction.followup.send(
            "❌ This can only be used inside a server.",
            ephemeral=True
        )
        return

    tester_role = discord.utils.get(
        interaction.guild.roles,
        name=TESTER_TEAM_ROLE_NAME
    )

    is_tester = (
        tester_role is not None
        and tester_role in interaction.user.roles
    )

    if (
        not is_tester
        and not interaction.user.guild_permissions.manage_messages
    ):
        await interaction.followup.send(
            "❌ **TESTER TEAM only.**",
            ephemeral=True
        )
        return

    mode = gamemode.value
    server = server.strip()

    if not server:
        await interaction.followup.send(
            "❌ Please provide a server IP.",
            ephemeral=True
        )
        return

    emoji_names={"axe":"axe","sword":"sword","vanilla":"vanilla","smp":"smp","pot":"pot","mace":"mace","nethop":"nethop","uhc":"uhc"}
    mode_emoji=discord.utils.get(interaction.guild.emojis,name=emoji_names.get(mode.lower()))
    emoji_text=str(mode_emoji) if mode_emoji else ""

    _, channel_name = QUEUE_CONFIG[mode]

    channel = discord.utils.get(
        interaction.guild.text_channels,
        name=channel_name
    )

    if channel is None:
        await interaction.followup.send(
            f"❌ Channel `#{channel_name}` was not found.",
            ephemeral=True
        )
        return

    # Remove the previous closed-status message when reopening.
    queue = load_queue()
    closed_message_id = queue.pop(f"{mode}_closed_message_id", None)

    if closed_message_id:
        try:
            closed_message = await channel.fetch_message(
                int(closed_message_id)
            )
            await closed_message.delete()
        except Exception:
            pass

    queue[f"{mode}_server"] = server
    save_queue(queue)

    # The person opening the queue becomes the active tester.
    set_active_tester(mode, interaction.user.id)

    embed = await build_queue_embed(
        interaction.guild,
        mode
    )

    waitlist_role_name, _ = QUEUE_CONFIG[mode]
    waitlist_role = discord.utils.get(
        interaction.guild.roles,
        name=waitlist_role_name
    )

    announcement_content = (
        waitlist_role.mention
        if waitlist_role is not None
        else f"@{waitlist_role_name}"
    )

    panel_message = await channel.send(
        content=announcement_content,
        embed=embed,
        view=QueuePanelView(mode),
        allowed_mentions=discord.AllowedMentions(
            roles=True
        )
    )

    # Store the exact panel message so future refreshes can
    # fetch it directly instead of scanning channel history.
    queue = load_queue()
    queue[f"{mode}_panel_message_id"] = panel_message.id
    save_queue(queue)

    await interaction.followup.send(
        f"✅ **{mode.title()} queue opened!**\n"
        f"Posted in {channel.mention}.",
        ephemeral=True
    )


