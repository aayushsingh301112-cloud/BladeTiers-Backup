GUIDE_COOLDOWN_SECONDS = 300
guide_last_sent = 0.0

GUIDE_MESSAGE = """# Guide

https://youtu.be/XkLkE_wnDXA"""

@bot.event
async def on_message(message):
    global guide_last_sent

    if message.author.bot:
        return

    if message.content.strip().lower() == "guide":
        now = time.monotonic()

        if now - guide_last_sent >= GUIDE_COOLDOWN_SECONDS:
            guide_last_sent = now
            try:
                await message.channel.send(GUIDE_MESSAGE)
            except discord.HTTPException as e:
                print(f"⚠️ Failed to send guide message: {e}")

    await bot.process_commands(message)


